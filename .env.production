# ========================================
# LCA Platform - Production Configuration
# ========================================

APP_NAME=LCA Platform
APP_VERSION=1.0.0
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Security - Generate a real key: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=CHANGE_ME_BEFORE_DEPLOY
APP_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database - SQLite (persistent volume)
DATABASE_URL=sqlite:///./lca_platform.db
DATABASE_ECHO=false

# Paths
MODEL_DIR=./backend/models
OUTPUT_DIR=./backend/outputs
DATA_DIR=./backend/data

# Logging
LOG_LEVEL=INFO

# CORS - Update with your domain/IP
CORS_ORIGINS=["http://localhost","http://localhost:8000"]
