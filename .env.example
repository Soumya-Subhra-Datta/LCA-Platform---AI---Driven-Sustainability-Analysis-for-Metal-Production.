# ========================================
# LCA Platform Environment Configuration
# ========================================

# Application
APP_NAME=LCA Platform
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Security - CHANGE IN PRODUCTION
APP_SECRET_KEY=change-me-to-a-random-secret-key-in-production
APP_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
# SQLite (default for development)
DATABASE_URL=sqlite:///./lca_platform.db
# MySQL (uncomment for production)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/lca_platform
# TiDB Serverless (MySQL-compatible). TLS is required - pymysql 1.1.0+ handles ssl_verify_* flags:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@GATEWAY_HOST:4000/lca_platform?ssl_verify_cert=true&ssl_verify_identity=true
DATABASE_ECHO=false

# Paths
MODEL_DIR=./backend/models
OUTPUT_DIR=./backend/outputs
DATA_DIR=./backend/data

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# AWS Deployment (uncomment when deploying)
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=lca-platform-models
# RDS_HOST=your-rds-endpoint.amazonaws.com
# RDS_PORT=3306
# RDS_DB_NAME=lca_platform
# RDS_USERNAME=admin
# RDS_PASSWORD=your-secure-password

# ========================================
# Frontend (React) Configuration
# ========================================
# Create frontend/.env from frontend/.env.example for Vite-specific variables.
# At runtime, the Express server (frontend/server/index.js) forwards /api and
# /health to the backend using API_PROXY_TARGET (defaults to http://localhost:8000):
# API_PROXY_TARGET=http://localhost:8000
# PORT=3000
